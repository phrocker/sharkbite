{
  "schema": "shoal.router.grammar/v1",
  "target": {
    "kind": "action",
    "capability": "secops",
    "action": "rotate_credentials"
  },
  "cues": [
    "rotate",
    "credentials",
    "secrets"
  ],
  "patterns": [
    "rotate credentials for {service}",
    "rotate [the] {service} secrets"
  ],
  "slots": [
    {
      "name": "service",
      "node_kinds": [
        "service"
      ]
    }
  ],
  "input": {
    "service": "$service"
  }
}
