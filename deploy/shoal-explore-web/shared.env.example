# Example shared-instance settings. These are placeholders, not live values.
# Keep access tokens out of this file.

SHOAL_ALLOWED_HOST=shoal.example.test
SHOAL_OIDC_ISSUER=https://identity.example.test
SHOAL_OIDC_AUDIENCE=shoal-api
SHOAL_OIDC_AUTHORIZATION_CLAIM=roles
SHOAL_OIDC_READER_VALUES=shoal-reader
SHOAL_OIDC_CONTRIBUTOR_VALUES=shoal-contributor
SHOAL_OIDC_FLEET_VALUES=shoal-fleet

# The state root must be mounted on persistent storage. The command-line flag
# remains: -state-dir=/var/lib/shoal

# Host-owned executor references allowed for the two simulated Fleet agents.
SHOAL_FLEET_EXECUTOR_REFS=simulated-planning,simulated-delivery

# Registration keys are secrets supplied only to the seed process. Do not put
# their values in this file or in demo-scenario.json.
# SHOAL_DEMO_AGENT_KEY_ALEX=
# SHOAL_DEMO_AGENT_KEY_SAM=
