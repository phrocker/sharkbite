# Example environment for deploy/shoal-explore-web/docker-compose.yml.
# Copy to `.env` in this directory to override defaults.
#
# The configuration seam between local and shared deployments is the set of
# flags passed to the SAME image. The compose file exposes the ones that are
# safe to vary locally; the shared-instance flags are documented in
# docs/shoal-explore-web-deploy.md.

# Loopback listen address for the local development workspace. Must stay
# loopback (127.0.0.1 or [::1]) or the -dev-auth command refuses to serve.
SHOAL_EXPLORE_LISTEN=127.0.0.1:8098
